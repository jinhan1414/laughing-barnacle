# App runtime and local data paths.
# Use defaults for local development; change file paths when deploying
# with mounted volumes or a custom data directory.
APP_ADDR=:8080
APP_SETTINGS_FILE=./data/settings.json
APP_SKILLS_DIR=./data/skills
APP_SKILLS_STATE_FILE=./data/skills_state.json
APP_CONVERSATION_FILE=./data/conversation.json
APP_MEMORY_FILE=./data/memory.db
APP_LLM_LOG_FILE=./data/llm_logs.json

# LLM gateway routing defaults.
# DEFAULT_PROVIDER and DEFAULT_MODEL are used when request model has no provider prefix.
# AGENT_LLM_MODEL is the primary model used by chat turns.
LLM_GATEWAY_DEFAULT_PROVIDER=cerber
LLM_GATEWAY_DEFAULT_MODEL=gpt-4o-mini
LLM_GATEWAY_REQUEST_TIMEOUT=45s
AGENT_LLM_MODEL=cerber/gpt-4o-mini
# General model temperature for normal assistant replies.
CERBER_TEMPERATURE=0.2

# Cerber provider settings.
# Use these when default provider is "cerber" or when model prefix is "cerber/...".
LLM_GATEWAY_CERBER_BASE_URL=https://api.cerber.ai
LLM_GATEWAY_CERBER_API_KEY=your_api_key_here
# Retry policy for transient failures (429/5xx/network).
LLM_GATEWAY_CERBER_MAX_RETRIES=2
LLM_GATEWAY_CERBER_RETRY_BASE_DELAY=700ms
LLM_GATEWAY_CERBER_RETRY_MAX_DELAY=8s

# OpenAI Codex provider settings.
# Use these when model prefix is "openai-codex/...", e.g. openai-codex/gpt-5.3-codex.
# Auth priority: AUTH_FILE_PATH > API_KEY > default ~/.codex/auth.json.
LLM_GATEWAY_OPENAI_CODEX_BASE_URL=https://api.openai.com
# Optional static token/API key. Leave empty when using Codex auth.json OAuth.
LLM_GATEWAY_OPENAI_CODEX_API_KEY=
# Explicit path to Codex auth file. Set this for non-default locations (Windows/Linux containers).
# Example (Windows): C:\Users\<you>\.codex\auth.json
LLM_GATEWAY_OPENAI_CODEX_AUTH_FILE_PATH=
# Transport preference for Codex requests when provider supports it.
# "auto" is recommended for most cases.
LLM_GATEWAY_OPENAI_CODEX_TRANSPORT=auto
LLM_GATEWAY_OPENAI_CODEX_MAX_RETRIES=1

# MCP integration settings.
# Keep defaults unless your MCP server requires a different protocol version/timeout.
MCP_HTTP_TIMEOUT=20s
MCP_PROTOCOL_VERSION=2025-06-18
MCP_TOOL_CACHE_TTL=30s

# Agent runtime and context/memory controls.
# Tune these only when you need to change context compression or memory behavior.
AGENT_MAX_RECENT_MESSAGES=10
AGENT_COMPRESSION_TRIGGER_MESSAGES=20
AGENT_COMPRESSION_TRIGGER_CHARS=9000
AGENT_KEEP_RECENT_AFTER_COMPRESSION=8
AGENT_MAX_COMPRESSION_LOOPS=3
AGENT_MAX_TOOL_CALL_ROUNDS=10
AGENT_WINDOWS_SHELL=auto
AGENT_MEMORY_IDLE_WINDOW=5m
AGENT_MEMORY_MAX_SEGMENT_WINDOW=10m
AGENT_MEMORY_MAX_SEGMENT_MESSAGES=8
AGENT_MEMORY_WORKER_INTERVAL=30s
AGENT_MEMORY_TRASH_TTL=720h
AGENT_MEMORY_FAILED_RETRY_AFTER=2m
AGENT_MEMORY_EXTRACTION_USE_LLM=true
AGENT_MEMORY_EXTRACTION_FALLBACK=true
AGENT_MEMORY_EXTRACTION_MODEL=cerber/gpt-4o-mini
AGENT_MEMORY_EXTRACTION_TEMPERATURE=0

# Max number of request/response logs kept in local LLM log storage.
APP_LLM_LOG_LIMIT=500
